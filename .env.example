# openai = served endpoint (vLLM); transformers = in-process, no server
LEDGERCTL_BACKEND=openai
LEDGERCTL_SEED=0
LEDGERCTL_DATA_DIR=./data
LEDGERCTL_RESULTS_DIR=./results

# OpenAI-compatible endpoint (vLLM: `vllm serve <model> --port 8000`)
LEDGERCTL_BASE_URL=http://localhost:8000/v1
LEDGERCTL_SMALL_BASE_URL=http://localhost:8001/v1
LEDGERCTL_API_KEY=EMPTY

LEDGERCTL_SUMMARISER_MODEL=Qwen/Qwen2.5-7B-Instruct
LEDGERCTL_STEP_MONITOR_MODEL=Qwen/Qwen2.5-7B-Instruct
LEDGERCTL_GLOBAL_MONITOR_MODEL=Qwen/Qwen2.5-14B-Instruct
# served alone, only for the full_context baseline pass
LEDGERCTL_BASELINE_MONITOR_MODEL=Qwen/Qwen2.5-32B-Instruct
LEDGERCTL_BASELINE_BASE_URL=http://localhost:8002/v1

LEDGERCTL_SUMMARY_MAX_TOKENS=64
LEDGERCTL_MAX_FETCHES_PER_STEP=4
LEDGERCTL_AUDIT_BUDGET=0.01
